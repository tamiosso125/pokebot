# Opcional: chave gratuita do pokemontcg.io (sobe o limite de 1.000 para 20.000 requisições/dia)
POKEMONTCG_API_KEY=
# Token de acesso da API do Mercado Livre (necessário se a busca pública responder 401/403)
MELI_ACCESS_TOKEN=
# Caminho do banco SQLite local
POKEBOT_DB=data/pokebot.db
# Cotação usada para converter o preço do TCGPlayer (USD) em reais; atualize de vez em quando
USD_BRL=5.50
# Análise de imagem: chave da API da Anthropic (console.anthropic.com) e modelo usado
ANTHROPIC_API_KEY=
POKEBOT_VISION_MODEL=claude-sonnet-5-5
# Alertas no Telegram: crie um bot com @BotFather e pegue seu chat id (ex.: via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Só avisa anúncios pelo menos X% abaixo do preço de referência
MIN_DISCOUNT_PCT=30
# Buscas do vigia no Mercado Livre, separadas por ponto e vírgula
POKEBOT_QUERIES=carta pokemon;pokemon alt art;pokemon v
